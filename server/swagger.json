{
  "openapi": "3.0.3",
  "info": {
    "title": "CIMOL - Gestão Escolar API",
    "version": "2.0.0",
    "description": "API de horários URÂNIA UP, blocos, salas e reorganização. Importações passam por uma área temporária e somente versões aprovadas pelo CPD são publicadas."
  },
  "servers": [{ "url": "http://localhost:3001", "description": "Desenvolvimento" }],
  "tags": [
    { "name": "Autenticação" },
    { "name": "URÂNIA UP" },
    { "name": "Horários públicos" },
    { "name": "Notificações" },
    { "name": "Eventos" },
    { "name": "Setores" },
    { "name": "Relatos" },
    { "name": "Mapas" },
    { "name": "Intervalos" },
    { "name": "Blocos" },
    { "name": "Salas" },
    { "name": "Reorganização" }
  ],
  "components": {
    "securitySchemes": {
      "SessionCookie": { "type": "apiKey", "in": "cookie", "name": "cimol_session" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "error": { "type": "string", "example": "NOTIFICATION_REQUEST_LIMIT" },
          "availableAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "nome": { "type": "string" },
          "usuario": { "type": "string" },
          "papel": { "type": "string", "enum": ["ADMIN", "CPD"] }
        }
      },
      "BlocoInput": {
        "type": "object",
        "required": ["nome"],
        "properties": { "nome": { "type": "string" }, "descricao": { "type": "string", "nullable": true } }
      },
      "SalaInput": {
        "type": "object",
        "required": ["bloco_id", "nome", "andar", "tipo"],
        "properties": {
          "bloco_id": { "type": "integer" },
          "nome": { "type": "string" },
          "andar": { "type": "string" },
          "capacidade": { "type": "integer", "minimum": 1, "nullable": true },
          "tipo": { "type": "string" },
          "possui_computadores": { "type": "boolean" },
          "possui_data_show": { "type": "boolean" },
          "possui_internet": { "type": "boolean" },
          "possui_ar_condicionado": { "type": "boolean" },
          "softwares": { "type": "array", "items": { "type": "string" } },
          "observacoes": { "type": "string", "nullable": true }
        }
      },
      "Horario": {
        "type": "object",
        "properties": {
          "turma": { "type": "string", "example": "INFO 63 1" },
          "curso": { "type": "string", "example": "Informática" },
          "ano": { "type": "string", "example": "3" },
          "dia": { "type": "string", "example": "SEG" },
          "periodo": { "type": "integer", "example": 1 },
          "hora_inicio": { "type": "string", "nullable": true, "example": "07:30" },
          "disciplina": { "type": "string" },
          "professor": { "type": "string", "nullable": true },
          "sala_id": { "type": "integer", "nullable": true },
          "ambiente": { "type": "string", "nullable": true },
          "sala": { "type": "string", "nullable": true }
        }
      },
      "EventoInput": {
        "type": "object",
        "required": ["titulo", "data_evento"],
        "properties": {
          "titulo": { "type": "string" },
          "descricao": { "type": "string", "nullable": true },
          "data_evento": { "type": "string", "format": "date" },
          "hora_evento": { "type": "string", "nullable": true, "example": "19:30" },
          "local": { "type": "string", "nullable": true },
          "imagem_url": { "type": "string", "nullable": true },
          "ativo": { "type": "boolean" }
        }
      },
      "SetorInput": {
        "type": "object",
        "required": ["nome", "descricao"],
        "properties": {
          "nome": { "type": "string" },
          "descricao": { "type": "string" },
          "responsavel": { "type": "string", "nullable": true },
          "localizacao": { "type": "string", "nullable": true },
          "contato": { "type": "string", "nullable": true },
          "horario_atendimento": { "type": "string", "nullable": true },
          "icone": { "type": "string" },
          "cor": { "type": "string" },
          "ativo": { "type": "boolean" }
        }
      },
      "RelatoInput": {
        "type": "object",
        "required": ["categoria"],
        "properties": {
          "nome": { "type": "string", "nullable": true },
          "perfil": { "type": "string", "nullable": true, "enum": ["ALUNO", "DOCENTE", "RESPONSAVEL", "COMUNIDADE"] },
          "categoria": { "type": "string", "enum": ["HORARIO_INCORRETO", "SALA_LOCAL_INCORRETO", "SALA_INDISPONIVEL", "MUDANCA_NAO_ATUALIZADA", "CONFLITO_HORARIO", "LOCALIZACAO_INCORRETA", "INFORMACAO_INCORRETA"] },
          "origem": { "type": "string", "enum": ["FORMULARIO", "HORARIO", "SALA", "SETOR", "MAPA"] },
          "setor_id": { "type": "integer", "nullable": true },
          "sala_id": { "type": "integer", "nullable": true },
          "horario_id": { "type": "integer", "nullable": true },
          "mapa_area_id": { "type": "integer", "nullable": true },
          "assunto": { "type": "string", "nullable": true },
          "mensagem": { "type": "string", "nullable": true }
        }
      },
      "MapaInput": {
        "type": "object",
        "required": ["nome", "largura", "altura", "areas"],
        "properties": {
          "nome": { "type": "string" }, "piso": { "type": "string", "nullable": true },
          "largura": { "type": "integer" }, "altura": { "type": "integer" }, "ativo": { "type": "boolean" },
          "areas": { "type": "array", "items": { "type": "object", "required": ["tipo", "nome", "caminho_svg"], "properties": {
            "id": { "type": "integer", "nullable": true, "description": "Obrigatório no PUT para preservar uma área existente; omita para criar uma nova." },
            "tipo": { "type": "string", "enum": ["BLOCO", "SALA", "SETOR", "OUTRO"] }, "nome": { "type": "string" },
            "caminho_svg": { "type": "string" }, "bloco_id": { "type": "integer", "nullable": true },
            "sala_id": { "type": "integer", "nullable": true }, "setor_id": { "type": "integer", "nullable": true }
          } } }
        }
      },
      "IntervaloInput": {
        "type": "object", "required": ["nome", "hora_inicio", "hora_fim", "grupo_ids"],
        "properties": { "nome": { "type": "string" }, "hora_inicio": { "type": "string", "example": "09:30" },
          "hora_fim": { "type": "string", "example": "09:45" }, "ativo": { "type": "boolean" },
          "grupo_ids": { "type": "array", "items": { "type": "integer" } } }
        }
      }
    },
  "paths": {
    "/api/health": {
      "get": { "summary": "Verificar API e banco", "responses": { "200": { "description": "Disponível" } } }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Autenticação"], "summary": "Iniciar sessão",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["usuario", "senha"], "properties": { "usuario": { "type": "string" }, "senha": { "type": "string", "format": "password" } } } } } },
        "responses": { "200": { "description": "Sessão criada" }, "401": { "description": "Credenciais inválidas" } }
      }
    },
    "/api/auth/me": {
      "get": { "tags": ["Autenticação"], "summary": "Consultar sessão", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Usuário autenticado" }, "401": { "description": "Sem sessão" } } }
    },
    "/api/auth/logout": {
      "post": { "tags": ["Autenticação"], "summary": "Encerrar sessão", "responses": { "200": { "description": "Sessão encerrada" } } }
    },
    "/api/importacoes/urania": {
      "post": {
        "tags": ["URÂNIA UP"], "summary": "Enviar HTML/XML para a área temporária", "description": "Somente o operador URÂNIA (papel ADMIN). Esse papel não acessa a análise ou outros módulos.", "security": [{ "SessionCookie": [] }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["arquivos"], "properties": { "arquivos": { "type": "array", "items": { "type": "string", "format": "binary" } }, "observacoes": { "type": "string" } } } } } },
        "responses": { "201": { "description": "Importação pendente criada" }, "400": { "description": "Arquivo inválido" }, "403": { "description": "Papel não autorizado" }, "422": { "description": "Estrutura URÂNIA inválida" } }
      }
    },
    "/api/importacoes": {
      "get": { "tags": ["URÂNIA UP"], "summary": "Listar pendências e histórico", "description": "Somente CPD.", "security": [{ "SessionCookie": [] }], "parameters": [{ "in": "query", "name": "status", "schema": { "type": "string", "enum": ["PENDENTE", "APROVADA", "REJEITADA"] } }], "responses": { "200": { "description": "Importações" } } }
    },
    "/api/importacoes/{id}": {
      "get": { "tags": ["URÂNIA UP"], "summary": "Visualizar importação e horários", "security": [{ "SessionCookie": [] }], "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }, { "in": "query", "name": "turma", "schema": { "type": "string" } }], "responses": { "200": { "description": "Prévia" }, "404": { "description": "Não encontrada" } } }
    },
    "/api/importacoes/{id}/aprovar": {
      "post": { "tags": ["URÂNIA UP"], "summary": "Aprovar e publicar", "description": "Somente CPD.", "security": [{ "SessionCookie": [] }], "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Publicada" }, "403": { "description": "Papel não autorizado" }, "409": { "description": "Já revisada" } } }
    },
    "/api/importacoes/{id}/rejeitar": {
      "post": { "tags": ["URÂNIA UP"], "summary": "Rejeitar importação", "description": "Somente CPD.", "security": [{ "SessionCookie": [] }], "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["motivo"], "properties": { "motivo": { "type": "string" } } } } } }, "responses": { "200": { "description": "Rejeitada" }, "400": { "description": "Motivo ausente" } } }
    },
    "/api/horarios/publicados": {
      "get": { "tags": ["Horários públicos"], "summary": "Consultar somente horários aprovados e ativos", "parameters": [{ "in": "query", "name": "turma", "schema": { "type": "string" } }, { "in": "query", "name": "curso", "schema": { "type": "string" } }, { "in": "query", "name": "ano", "schema": { "type": "string" } }, { "in": "query", "name": "dia", "schema": { "type": "string" } }, { "in": "query", "name": "apenas_opcoes", "schema": { "type": "boolean" } }], "responses": { "200": { "description": "Turmas e horários publicados" } } }
    },
    "/api/horarios/notificacoes": {
      "post": {
        "tags": ["Notificações"], "summary": "Solicitar avisos de alterações da grade",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email", "turma"], "properties": { "email": { "type": "string", "format": "email", "example": "aluno@estudante.rs.gov.br" }, "turma": { "type": "string" } } } } } },
        "responses": { "201": { "description": "Código enviado" }, "400": { "description": "E-mail ou turma inválidos" }, "429": { "description": "Cooldown de solicitações" } }
      }
    },
    "/api/horarios/notificacoes/verificar": {
      "post": {
        "tags": ["Notificações"], "summary": "Confirmar código e ativar avisos",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email", "turma", "code"], "properties": { "email": { "type": "string" }, "turma": { "type": "string" }, "code": { "type": "string", "pattern": "^[0-9]{6}$" } } } } } },
        "responses": { "200": { "description": "Notificações ativas por um ano" }, "400": { "description": "Código inválido ou expirado" }, "429": { "description": "Tentativas excessivas" } }
      }
    },
    "/api/horarios/notificacoes/confirmar": {
      "get": {
        "tags": ["Notificações"], "summary": "Confirmar avisos por link",
        "parameters": [{ "in": "query", "name": "token", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Notificações ativadas" }, "400": { "description": "Link inválido ou expirado" } }
      }
    },
    "/api/horarios/notificacoes/manutencao": {
      "get": {
        "tags": ["Notificações"], "summary": "Executar expiração e envio pendente", "description": "Endpoint para Vercel Cron ou scheduler externo. Exige Authorization: Bearer com NOTIFICATION_CRON_SECRET ou CRON_SECRET.",
        "responses": { "200": { "description": "Manutenção executada" }, "401": { "description": "Não autorizado" } }
      }
    },
    "/api/horarios/publicados/{id}/sala": {
      "patch": { "tags": ["Horários públicos"], "summary": "Configurar sala de um horário publicado", "description": "Somente CPD. Atualiza o vínculo de sala de uma aula publicada e ativa.", "security": [{ "SessionCookie": [] }], "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "sala_id": { "type": "integer", "nullable": true } } } } } }, "responses": { "200": { "description": "Sala configurada" }, "400": { "description": "Sala inválida" }, "401": { "description": "Sem sessão" }, "403": { "description": "Papel não autorizado" }, "404": { "description": "Horário não encontrado" } } }
    },
    "/api/eventos": {
      "get": { "tags": ["Eventos"], "summary": "Listar eventos publicados", "parameters": [{ "in": "query", "name": "incluir_inativos", "schema": { "type": "boolean" } }], "responses": { "200": { "description": "Eventos" } } },
      "post": { "tags": ["Eventos"], "summary": "Cadastrar evento", "security": [{ "SessionCookie": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventoInput" } } } }, "responses": { "201": { "description": "Criado" } } }
    },
    "/api/eventos/{id}": {
      "put": { "tags": ["Eventos"], "summary": "Atualizar evento", "security": [{ "SessionCookie": [] }], "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventoInput" } } } }, "responses": { "200": { "description": "Atualizado" } } },
      "delete": { "tags": ["Eventos"], "summary": "Excluir evento", "security": [{ "SessionCookie": [] }], "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Excluído" } } }
    },
    "/api/setores": {
      "get": { "tags": ["Setores"], "summary": "Listar setores publicados", "parameters": [{ "in": "query", "name": "incluir_inativos", "schema": { "type": "boolean" } }], "responses": { "200": { "description": "Setores" } } },
      "post": { "tags": ["Setores"], "summary": "Cadastrar setor", "security": [{ "SessionCookie": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetorInput" } } } }, "responses": { "201": { "description": "Criado" } } }
    },
    "/api/setores/{id}": {
      "put": { "tags": ["Setores"], "summary": "Atualizar setor", "security": [{ "SessionCookie": [] }], "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetorInput" } } } }, "responses": { "200": { "description": "Atualizado" } } },
      "delete": { "tags": ["Setores"], "summary": "Excluir setor", "security": [{ "SessionCookie": [] }], "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Excluído" } } }
    },
    "/api/ouvidoria": {
      "post": { "tags": ["Relatos"], "summary": "Alias legado para enviar relato", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RelatoInput" } } } }, "responses": { "201": { "description": "Recebido" } } },
      "get": { "tags": ["Relatos"], "summary": "Alias legado para listar relatos", "description": "Somente CPD.", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Relatos" } } }
    },
    "/api/ouvidoria/{id}": {
      "patch": { "tags": ["Relatos"], "summary": "Alias legado para atualizar status", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Status atualizado" } } }
    },
    "/api/relatos": {
      "post": { "tags": ["Relatos"], "summary": "Enviar relato rápido", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RelatoInput" } } } }, "responses": { "201": { "description": "Recebido" }, "400": { "description": "Categoria ou contexto inválido" } } },
      "get": { "tags": ["Relatos"], "summary": "Listar relatos", "description": "Somente CPD.", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Relatos paginados" } } }
    },
    "/api/relatos/{id}": { "patch": { "tags": ["Relatos"], "summary": "Atualizar status do relato", "description": "Somente CPD.", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Status atualizado" } } } },
    "/api/mapas": {
      "get": { "tags": ["Mapas"], "summary": "Listar mapas ativos e áreas", "responses": { "200": { "description": "Mapas" } } },
      "post": { "tags": ["Mapas"], "summary": "Criar mapa com áreas", "description": "Somente CPD.", "security": [{ "SessionCookie": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MapaInput" } } } }, "responses": { "201": { "description": "Criado" } } }
    },
    "/api/mapas/{id}": { "put": { "tags": ["Mapas"], "summary": "Substituir mapa e áreas", "description": "Somente CPD.", "security": [{ "SessionCookie": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MapaInput" } } } }, "responses": { "200": { "description": "Atualizado" } } } },
    "/api/mapas/{mapId}/areas": { "post": { "tags": ["Mapas"], "summary": "Adicionar desenho de bloco ao mapa", "description": "Somente CPD; exige bloco da instituição e vista de destino ativa. Se o desenho de bloco com mesmo nome foi ocultado, restaura-o.", "security": [{ "SessionCookie": [] }], "parameters": [{ "in": "path", "name": "mapId", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["nome", "caminho_svg", "bloco_id", "destino_mapa_id", "rotulo_x", "rotulo_y"], "properties": { "nome": { "type": "string" }, "caminho_svg": { "type": "string" }, "bloco_id": { "type": "integer" }, "destino_mapa_id": { "type": "integer" }, "rotulo_x": { "type": "number" }, "rotulo_y": { "type": "number" }, "descricao": { "type": "string" } } } } } }, "responses": { "201": { "description": "Área criada ou restaurada" }, "409": { "description": "Nome já usado ou limite atingido" } } } },
    "/api/mapas/{mapId}/areas/{areaId}": {
      "patch": { "tags": ["Mapas"], "summary": "Alterar vista aberta por bloco, acesso ou escada", "description": "Somente CPD. `anterior` deve conter nome, caminho_svg, bloco_id e destino_mapa_id lidos do mapa; conflito retorna 409.", "security": [{ "SessionCookie": [] }], "parameters": [{ "in": "path", "name": "mapId", "required": true, "schema": { "type": "integer" } }, { "in": "path", "name": "areaId", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["destino_mapa_id", "anterior"], "properties": { "destino_mapa_id": { "type": "integer" }, "anterior": { "type": "object" } } } } } }, "responses": { "200": { "description": "Destino atualizado" }, "409": { "description": "Área alterada por outra edição" } } },
      "delete": { "tags": ["Mapas"], "summary": "Ocultar desenho de bloco sem excluir bloco ou salas", "description": "Somente CPD. `anterior` deve conter os dados da área lida do mapa, incluindo ajuste e escala.", "security": [{ "SessionCookie": [] }], "parameters": [{ "in": "path", "name": "mapId", "required": true, "schema": { "type": "integer" } }, { "in": "path", "name": "areaId", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["anterior"], "properties": { "anterior": { "type": "object" } } } } } }, "responses": { "200": { "description": "Desenho ocultado" }, "409": { "description": "Área alterada por outra edição" } } }
    },
    "/api/grupos-academicos": { "get": { "tags": ["Intervalos"], "summary": "Listar grupos acadêmicos importados", "description": "Somente CPD.", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Grupos" } } } },
    "/api/intervalos": {
      "get": { "tags": ["Intervalos"], "summary": "Listar intervalos ativos", "responses": { "200": { "description": "Intervalos" } } },
      "post": { "tags": ["Intervalos"], "summary": "Criar intervalo", "description": "Somente CPD.", "security": [{ "SessionCookie": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IntervaloInput" } } } }, "responses": { "201": { "description": "Criado" } } }
    },
    "/api/intervalos/{id}": {
      "put": { "tags": ["Intervalos"], "summary": "Atualizar intervalo", "description": "Somente CPD.", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Atualizado" } } },
      "delete": { "tags": ["Intervalos"], "summary": "Desativar intervalo", "description": "Somente CPD.", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Desativado" } } }
    },
    "/api/blocos": {
      "get": { "tags": ["Blocos"], "summary": "Listar blocos", "responses": { "200": { "description": "Blocos" } } },
      "post": { "tags": ["Blocos"], "summary": "Cadastrar bloco", "security": [{ "SessionCookie": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BlocoInput" } } } }, "responses": { "201": { "description": "Criado" } } }
    },
    "/api/blocos/{id}": {
