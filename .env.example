API_PORT=3001
NODE_ENV=development
SERVE_STATIC=false

# Subdominio publico do frontend. Em producao, use HTTPS.
PUBLIC_ORIGIN=https://horarios.seudominio.edu.br

# Origens extras permitidas quando frontend e API estiverem em hosts diferentes.
# Exemplo: https://horarios.seudominio.edu.br,https://api-horarios.seudominio.edu.br
ALLOWED_ORIGINS=

# Use 1 quando a API estiver atras de proxy reverso/load balancer.
TRUST_PROXY=1
DEFAULT_INSTITUTION_SLUG=cimol
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha
DB_NAME=cimol
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Em Vercel, use a CA PEM em DB_SSL_CA (quebras como \n); localmente, use DB_SSL_CA_FILE.
DB_SSL_CA=
DB_SSL_CA_FILE=
# Crie um banco local somente ao executar db:bootstrap; nunca deixe isso ativo no runtime de produção.
DB_CREATE_DATABASE=false
# Opcional: use DATABASE_URL ou POSTGRES_URL no lugar de DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
DATABASE_URL=
POSTGRES_URL=
# Para Supabase, use DATABASE_URL somente no servidor, com DB_SSL=true,
# DB_SSL_REJECT_UNAUTHORIZED=true, DB_SSL_CA/DB_SSL_CA_FILE e DB_CREATE_DATABASE=false.
# Se a API usar o pooler transacional Supabase (:6543), db:migrate usa :5432
# somente durante a migração (pooler de sessão em redes sem IPv6).

# Usuários iniciais do painel. Troque as senhas antes de usar em produção.
ADMIN_NAME=Administrador
ADMIN_USER=admin
ADMIN_PASSWORD=troque_esta_senha
CPD_NAME=CPD
CPD_USER=cpd
CPD_PASSWORD=troque_esta_senha

# Usuario inicial da gestao da plataforma, separado dos usuarios das escolas.
PLATFORM_ADMIN_NAME=Gestor da plataforma
PLATFORM_ADMIN_USER=plataforma
PLATFORM_ADMIN_PASSWORD=troque_esta_senha

# Cookies de sessao. Mantenha COOKIE_DOMAIN vazio para usar cookie host-only.
# Se frontend e API estiverem em sites diferentes, use SameSite=None com COOKIE_SECURE=true.
COOKIE_DOMAIN=
COOKIE_SAMESITE=Lax
COOKIE_SECURE=true

# Limites de requisicoes por IP.
API_RATE_LIMIT=600
API_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT=30
UPLOAD_RATE_LIMIT_WINDOW_MS=900000

# SMTP para confirmacao e envio de avisos de horarios.
SMTP_HOST=smtp.seudominio.edu.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@seudominio.edu.br
SMTP_PASS=sua_senha_ou_app_password
SMTP_FROM="CIMOL <noreply@seudominio.edu.br>"

# Frontend em producao normalmente usa /api no mesmo subdominio.
# Preencha apenas se a API estiver em outro origin.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:3001
VITE_SHOW_TEST_LOGINS=false

# Servidor web de desenvolvimento.
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# Opcional quando o executável não estiver disponível no PATH.
PYTHON_BIN=C:\Program Files\Python310\python.exe
